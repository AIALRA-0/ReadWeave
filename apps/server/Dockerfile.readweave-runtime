# Supply the already-running, immutable image ID; retain its native modules.
ARG RUNTIME_BASE
FROM ${RUNTIME_BASE}
ARG REVISION
LABEL org.opencontainers.image.revision=${REVISION}
LABEL org.opencontainers.image.source=https://github.com/AIALRA-0/ReadWeave
LABEL org.opencontainers.image.version=0.104.0
COPY apps/server/dist/main.cjs /usr/src/app/main.cjs
COPY apps/server/dist/docker_healthcheck.cjs /usr/src/app/docker_healthcheck.cjs
COPY apps/server/dist/meta.json /usr/src/app/meta.json
COPY apps/server/dist/assets/ /usr/src/app/assets/
COPY apps/server/dist/public/ /usr/src/app/public/
COPY apps/server/dist/pdfjs-viewer/ /usr/src/app/pdfjs-viewer/
COPY apps/server/dist/share-theme/ /usr/src/app/share-theme/
COPY apps/server/dist/ckeditor5-content.css /usr/src/app/ckeditor5-content.css

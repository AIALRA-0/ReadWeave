{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readweave.local/schemas/readweave-index-export-1.2.schema.json",
  "title": "ReadWeave index export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exportId",
    "exportedAt",
    "generator",
    "scope",
    "articles",
    "anchors",
    "objects",
    "links",
    "integrity"
  ],
  "properties": {
    "schemaVersion": { "const": "1.2" },
    "exportId": { "$ref": "#/$defs/id" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "generator": { "$ref": "#/$defs/generator" },
    "scope": { "$ref": "#/$defs/scope" },
    "articles": { "type": "array", "items": { "$ref": "#/$defs/article" } },
    "anchors": { "type": "array", "items": { "$ref": "#/$defs/anchor" } },
    "objects": { "type": "array", "items": { "$ref": "#/$defs/indexObject" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/objectLink" } },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s]+$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "triliumVersion", "workflowVersion"],
      "properties": {
        "name": { "const": "ReadWeave" },
        "version": { "type": "string", "minLength": 1 },
        "triliumVersion": { "type": "string", "minLength": 1 },
        "workflowVersion": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "includeContent"],
      "properties": {
        "type": { "enum": ["all", "articles"] },
        "articleIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "includeContent": { "const": true }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "articles" } }, "required": ["type"] },
          "then": { "required": ["articleIds"] }
        }
      ]
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["articleId", "title"],
      "properties": {
        "articleId": { "$ref": "#/$defs/id" },
        "title": { "type": "string" }
      }
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "readweave-paragraph-v1" },
            "value": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value", "quote"],
          "properties": {
            "type": { "const": "readweave-range-v1" },
            "value": { "$ref": "#/$defs/id" },
            "quote": { "type": "string" }
          }
        }
      ]
    },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "blockIndex", "startOffset", "endOffset", "prefix", "suffix"],
      "properties": {
        "version": { "const": 1 },
        "blockIndex": { "type": "integer", "minimum": 0 },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 0 },
        "prefix": { "type": "string", "maxLength": 64 },
        "suffix": { "type": "string", "maxLength": 64 }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchorId", "articleId", "selector", "excerpt"],
      "properties": {
        "anchorId": { "$ref": "#/$defs/id" },
        "articleId": { "$ref": "#/$defs/id" },
        "selector": { "$ref": "#/$defs/selector" },
        "excerpt": { "type": "string" },
        "sourceLocator": { "$ref": "#/$defs/sourceLocator" }
      }
    },
    "indexObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "objectId",
        "kind",
        "title",
        "body",
        "normalizedTitle",
        "calloutType",
        "revision",
        "sourceArticleId",
        "sourceAnchorId",
        "sourceExcerpt",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1.2" },
        "objectId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["question", "term"] },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "normalizedTitle": { "type": "string" },
        "calloutType": { "$ref": "#/$defs/calloutType" },
        "termIdentity": { "$ref": "#/$defs/termIdentity" },
        "verifiedNonExpandableArtifact": { "$ref": "#/$defs/verifiedNonExpandableArtifact" },
        "evidenceSources": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceSource" }
        },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim" }
        },
        "audit": { "$ref": "#/$defs/generationAudit" },
        "qualityState": { "$ref": "#/$defs/qualityState" },
        "revision": { "type": "integer", "minimum": 1 },
        "sourceArticleId": { "$ref": "#/$defs/id" },
        "sourceAnchorId": { "$ref": "#/$defs/id" },
        "sourceExcerpt": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "objectLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "linkId",
        "articleId",
        "anchorId",
        "anchorType",
        "objectId",
        "sourceExcerpt",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1.2" },
        "linkId": { "$ref": "#/$defs/id" },
        "articleId": { "$ref": "#/$defs/id" },
        "anchorId": { "$ref": "#/$defs/id" },
        "anchorType": { "enum": ["paragraph", "range"] },
        "objectId": { "$ref": "#/$defs/id" },
        "parentLinkId": { "$ref": "#/$defs/id" },
        "rootLinkId": { "$ref": "#/$defs/id" },
        "depth": { "type": "integer", "minimum": 0, "maximum": 5 },
        "parentRevision": { "type": "integer", "minimum": 1 },
        "sourceExcerpt": { "type": "string" },
        "sourceLocator": { "$ref": "#/$defs/sourceLocator" },
        "displayTitle": { "type": "string" },
        "displayBody": { "type": "string" },
        "displayCalloutType": { "$ref": "#/$defs/calloutType" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "calloutType": {
      "enum": ["note", "tip", "important", "warning", "caution"]
    },
    "qualityState": {
      "enum": ["legacy-unverified", "verified", "provisional"]
    },
    "evidenceState": {
      "enum": ["not-checked", "local-only", "externally-checked", "conflicted", "insufficient"]
    },
    "termIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "abbreviation": { "type": "string", "minLength": 1 },
        "chineseName": { "type": "string", "minLength": 1 },
        "englishName": { "type": "string", "minLength": 1 }
      }
    },
    "verifiedNonExpandableArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originalName", "entityType"],
      "properties": {
        "originalName": { "type": "string", "minLength": 1 },
        "entityType": { "enum": ["method", "system", "product"] }
      }
    },
    "evidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceType", "provider", "title", "excerpt", "accessedAt"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "sourceType": { "enum": ["local", "external"] },
        "provider": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "excerpt": { "type": "string" },
        "publishedAt": { "type": "string" },
        "accessedAt": { "type": "string", "format": "date-time" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "text", "sourceIds", "confidence"],
      "properties": {
        "claimId": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "unresolved": { "type": "boolean" }
      }
    },
    "questionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalizedQuestion", "objective", "answerRequirements", "exclusions", "searchQueries", "requiresCurrentEvidence"],
      "properties": {
        "normalizedQuestion": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "answerRequirements": { "type": "array", "items": { "type": "string" } },
        "exclusions": { "type": "array", "items": { "type": "string" } },
        "searchQueries": { "type": "array", "items": { "type": "string" } },
        "requiresCurrentEvidence": { "type": "boolean" }
      }
    },
    "generationAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowVersion", "questionContract", "searchQueries", "unresolvedClaims", "validationIssues", "citationsVerified", "generatedAt"],
      "properties": {
        "workflowVersion": { "enum": ["unified-evidence-v1", "quality-closure-v2"] },
        "harnessVersion": { "type": "string", "minLength": 1 },
        "qualityState": { "$ref": "#/$defs/qualityState" },
        "evidenceState": { "$ref": "#/$defs/evidenceState" },
        "independentVerification": { "enum": ["passed", "failed", "not-run"] },
        "unresolvedIssues": { "type": "array", "items": { "type": "string" } },
        "questionContract": { "$ref": "#/$defs/questionContract" },
        "searchQueries": { "type": "array", "items": { "type": "string" } },
        "unresolvedClaims": { "type": "array", "items": { "type": "string" } },
        "validationIssues": { "type": "array", "items": { "type": "string" } },
        "citationsVerified": { "type": "boolean" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "manuallyEdited": { "type": "boolean" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "articleCount", "anchorCount", "objectCount", "linkCount", "contentSha256"],
      "properties": {
        "valid": { "type": "boolean" },
        "articleCount": { "type": "integer", "minimum": 0 },
        "anchorCount": { "type": "integer", "minimum": 0 },
        "objectCount": { "type": "integer", "minimum": 0 },
        "linkCount": { "type": "integer", "minimum": 0 },
        "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}

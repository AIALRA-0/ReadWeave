# Optional server-only fallback. Prefer the in-app ReadWeave settings for a personal installation.
# Never commit a real credential.
READWEAVE_DEEPSEEK_API_KEY=<server-only-key>
READWEAVE_API_BASE_URL=https://api.deepseek.com
READWEAVE_DEEPSEEK_MODEL=deepseek-chat

# Optional independent semantic verifier. In production prefer the root-only
# VPS file /srv/aialra/secrets/readweave-verifier.env rather than this project
# environment. Use a different service origin and model family from the writer;
# placeholders below are intentionally fake.
READWEAVE_VERIFIER_API_KEY=<independent-verifier-server-only-key>
READWEAVE_VERIFIER_API_BASE_URL=https://independent-verifier.example.com/v1
READWEAVE_VERIFIER_MODEL=independent-verifier-model
